{
	"info": {
		"_postman_id": "job-recruitment-career-platform-api-full",
		"name": "Job Recruitment & Career Platform API (Corrected)",
		"description": "Comprehensive, standardized, and corrected API endpoints for Job Recruitment & Career Platform",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8000/api",
			"type": "string"
		},
		{
			"key": "authToken",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication (Auth)",
			"item": [
				{
					"name": "Register User/Company",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123!\",\n  \"password_confirmation\": \"Password123!\",\n  \"role\": \"user\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "register"]
						},
						"description": "Replaces incorrect 'POST Rgister'"
					}
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"mengsiek8@gmail.com\",\n  \"password\": \"meng@123gris\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						},
						"description": "Returns bearer token upon successful authentication."
					}
				},
				{
					"name": "Verify OTP",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"john@example.com\",\n  \"code\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/verify-otp",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "verify-otp"]
						},
						"description": "Replaces incorrect 'GET verify-Otp'"
					}
				},
				{
					"name": "Google Redirect (Auth Config)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{baseUrl}}/auth/google",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "google"]
						},
						"description": "Replaces incorrect 'GET GoogleConfig'"
					}
				},
				{
					"name": "Google Callback",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{baseUrl}}/auth/google/callback",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "google", "callback"]
						},
						"description": "Replaces incorrect 'GET Google-callBack'"
					}
				},
				{
					"name": "Telegram Redirect (Auth Config)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{baseUrl}}/auth/telegram",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "telegram"]
						},
						"description": "Replaces incorrect 'GET Telegram-config'"
					}
				}
			]
		},
		{
			"name": "2. Job Categories",
			"item": [
				{
					"name": "Get Job Categories (List)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{authToken}}" },
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{baseUrl}}/admin/job-categories",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "job-categories"]
						},
						"description": "Replaces incorrect 'POST Jo-categories'"
					}
				},
				{
					"name": "Create Job Category",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{authToken}}" },
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Software Engineering\",\n  \"slug\": \"software-engineering\",\n  \"description\": \"IT & Tech Jobs\",\n  \"is_active\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/job-categories",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "job-categories"]
						},
						"description": "Create a new job category (Admin)"
					}
				}
			]
		},
		{
			"name": "3. Company & Status",
			"item": [
				{
					"name": "Get Companies List (Admin)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{authToken}}" },
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{baseUrl}}/admin/companies",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "companies"]
						},
						"description": "Replaces incorrect 'POST company'"
					}
				},
				{
					"name": "Create Company Profile (Company Role)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{authToken}}" },
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Tech Solutions Inc\",\n  \"email\": \"hr@techsolutions.com\",\n  \"website\": \"https://techsolutions.com\",\n  \"description\": \"Leading software company\",\n  \"location\": \"Phnom Penh\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/company/profile",
							"host": ["{{baseUrl}}"],
							"path": ["company", "profile"]
						},
						"description": "Store company profile"
					}
				},
				{
					"name": "Update Company Status (Admin)",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{authToken}}" },
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"approved\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/companies/1/status",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "companies", "1", "status"]
						},
						"description": "Replaces incorrect 'PUT company_status'"
					}
				}
			]
		},
		{
			"name": "4. Job Posts & Skills",
			"item": [
				{
					"name": "List Job Posts",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{authToken}}" },
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{baseUrl}}/admin/job-posts",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "job-posts"]
						},
						"description": "Replaces incorrect 'POST Job_post'"
					}
				},
				{
					"name": "Create Job Post",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{authToken}}" },
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"company_id\": 1,\n  \"category_id\": 1,\n  \"title\": \"Backend Laravel Developer\",\n  \"description\": \"Responsible for maintaining API routes.\",\n  \"location\": \"Phnom Penh\",\n  \"job_type\": \"full-time\",\n  \"salary_min\": 1200,\n  \"salary_max\": 2500\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/job-posts",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "job-posts"]
						},
						"description": "Create job posting"
					}
				},
				{
					"name": "List Skills",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{authToken}}" },
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{baseUrl}}/admin/skills",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "skills"]
						},
						"description": "Replaces incorrect 'GET Job_skill'"
					}
				}
			]
		},
		{
			"name": "5. Queue Jobs, Batches & Failed Jobs",
			"item": [
				{
					"name": "Get Jobs (Queue)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{authToken}}" },
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{baseUrl}}/admin/jobs",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "jobs"]
						},
						"description": "Replaces incorrect 'POST Job'"
					}
				},
				{
					"name": "Get Job Batches",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{authToken}}" },
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{baseUrl}}/admin/job-batches",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "job-batches"]
						},
						"description": "Replaces incorrect 'POST Job_batch'"
					}
				},
				{
					"name": "Get Failed Jobs",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{authToken}}" },
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{baseUrl}}/admin/failed-jobs",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "failed-jobs"]
						},
						"description": "Replaces incorrect 'POST failed-jobs'"
					}
				},
				{
					"name": "Retry Failed Job",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{authToken}}" },
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{baseUrl}}/admin/failed-jobs/1/retry",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "failed-jobs", "1", "retry"]
						},
						"description": "Re-queue failed job"
					}
				}
			]
		},
		{
			"name": "6. Applications (Admin & Jobseeker)",
			"item": [
				{
					"name": "Admin - Get All Applications",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{authToken}}" },
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{baseUrl}}/admin/applications",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "applications"]
						},
						"description": "Replaces incorrect 'POST AdminApplication'"
					}
				},
				{
					"name": "User - Submit Job Application",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{authToken}}" },
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"job_post_id\": 1,\n  \"cover_letter\": \"I am excited to apply for this role.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/user/applications",
							"host": ["{{baseUrl}}"],
							"path": ["user", "applications"]
						},
						"description": "Jobseeker submits application for a job post"
					}
				},
				{
					"name": "User - Get My Applications",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{authToken}}" },
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{baseUrl}}/user/applications",
							"host": ["{{baseUrl}}"],
							"path": ["user", "applications"]
						},
						"description": "Jobseeker application history"
					}
				}
			]
		}
	]
}
